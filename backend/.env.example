# ===================== API KEYS =====================
# CRITICAL: NEVER commit actual API keys. Use .env for local development only
# Get these from their respective services

# OpenWeather API - Weather API integration
# Get key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=f6c3bb91052b9f8d79aefcc5c7efabbf

# Agmarknet API - Agricultural market data
# Get key from: https://data.gov.in/
AGMARKNET_API_KEY=your_agmarknet_api_key_here
API_KEY=your_agmarknet_api_key_here

# Google Gemini AI - Chatbot/AI features
# Get key from: https://ai.google.dev
GEMINI_API_KEY=your_gemini_api_key_here

# ===================== SERVER CONFIGURATION =====================
# Mandi/Soil API server
PORT=5000

# Weather API server
WEATHER_API_PORT=4001

# Disaster alert system server
DISASTER_PORT=4000

# Soil health API server
SOIL_API_PORT=5000

# Chatbot API server
CHATBOT_PORT=5001

# Node environment (development/production)
NODE_ENV=development

# ===================== DATABASE CONFIGURATION =====================
# MongoDB - Local Development
MONGODB_URI=mongodb://localhost:27017/haritnavinya-soil

# MongoDB Atlas - Production (uncomment for prod and fill credentials)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/haritnavinya-soil

# ===================== CORS CONFIGURATION =====================
# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:3001

# ===================== SOIL HEALTH CARD API =====================
# Government soil health assessment API
SOIL_HEALTH_CARD_API=https://www.soilhealth.dac.gov.in/api/GetMapData

# Cache TTL in milliseconds (default: 86400000 = 24 hours)
SOIL_DATA_CACHE_TTL=86400000

# ===================== LOGGING & MONITORING =====================
# Log level (debug/info/warn/error)
LOG_LEVEL=debug

# Enable request logging middleware
ENABLE_REQUEST_LOGGING=true
# ============================================

# Enable debug logging
DEBUG=false

# Cache TTL in seconds (default: 300 = 5 minutes)
CACHE_TTL=300

# Maximum records to fetch per API call
MAX_RECORDS=200

# Request timeout in milliseconds
REQUEST_TIMEOUT=10000

# ============================================
# AGRICULTURE CHATBOT - GEMINI API
# ============================================

# Google Gemini API Key (Required for chatbot)
# Get your free API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Chatbot server port
CHATBOT_PORT=5001

# Chatbot response timeout (milliseconds)
CHATBOT_TIMEOUT=30000

# Max message length
MAX_MESSAGE_LENGTH=10000
