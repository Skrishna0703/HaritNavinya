# Frontend API Configuration
# Development: Point to local backend (default ports)
# Production: Point to production backend URL

# API Base URL - Backend server address
# Local: http://localhost:5000
# Production: https://haritnavinya.onrender.com
VITE_API_BASE_URL=http://localhost:5000

# Individual service ports (for direct API calls)
# Update these if backend servers run on different ports
VITE_WEATHER_API_PORT=4001
VITE_DASHBOARD_API_PORT=5000
VITE_CHATBOT_API_PORT=5001
VITE_DISASTER_API_PORT=4000

# Frontend environment
NODE_ENV=development
